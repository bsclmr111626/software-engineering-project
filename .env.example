# Copy to .env for local development. Never commit .env.
# Placeholders only - generate your own secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included, e.g. https://codeguard.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=

# Role assigned to self-registered users: analyst or viewer (never admin)
CODEGUARD_DEFAULT_ROLE=analyst

# Who may register: open (development/classroom), domain (only CODEGUARD_REGISTRATION_DOMAINS),
# or closed (administrators create accounts). Public deployments should not use open.
CODEGUARD_REGISTRATION=open
# CODEGUARD_REGISTRATION_DOMAINS=example.edu,example.com

# Sign-in throttling (defaults shown)
# CODEGUARD_LOGIN_MAX_FAILURES=5
# CODEGUARD_LOGIN_IP_MAX_FAILURES=20
# CODEGUARD_LOGIN_LOCKOUT_MINUTES=15
# Header your reverse proxy sets to the visitor's address (e.g. X-Real-IP). Leave unset
# unless every request passes through a proxy that overwrites it.
# CODEGUARD_CLIENT_IP_HEADER=

# Optional
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# CODEGUARD_LOG_LEVEL=INFO
# CODEGUARD_LOG_FORMAT=text   # or json, one object per line

# Email in production. Without one of these, password resets, email confirmation and
# invitations are only printed to the server log (check --deploy warns: codeguard.W002).
# Brevo over HTTPS (works on hosts that block SMTP, e.g. PythonAnywhere's free plan):
# DJANGO_EMAIL_BACKEND=core.email.BrevoEmailBackend
# BREVO_API_KEY=
# DJANGO_DEFAULT_FROM_EMAIL=CodeGuard <verified-sender@example.com>
#
# Or SMTP:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=codeguard@example.edu
# DJANGO_EMAIL_HOST=smtp.example.edu
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true

# Shown on the contact, privacy and terms pages and in emails
# CODEGUARD_CONTACT_EMAIL=
# Server errors are emailed here when DEBUG is off (comma-separated)
# CODEGUARD_ADMIN_EMAILS=
# Link lifetimes (defaults shown); password reset links always last one hour
# CODEGUARD_EMAIL_VERIFICATION_HOURS=48
# CODEGUARD_INVITATION_DAYS=7
# Days between a user closing their account and its deletion (purge_closed_accounts)
# CODEGUARD_ACCOUNT_DELETION_DAYS=14

# Production (DEBUG=false) hardening - defaults shown
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# DJANGO_HSTS_SECONDS=3600
# DJANGO_BEHIND_PROXY=false
